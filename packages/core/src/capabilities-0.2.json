{
  "id": "basic-0.2",
  "schemaVersion": "0.2",
  "status": "experimental",
  "charts": ["bar", "line", "pie", "scatter", "combo", "funnel"],
  "modes": ["intent"],
  "variants": {
    "bar": ["horizontal"],
    "line": ["area"],
    "pie": ["donut"]
  },
  "themes": [
    {
      "id": "light",
      "version": "1"
    },
    {
      "id": "dark",
      "version": "1"
    }
  ],
  "outputs": ["browser", "svg"],
  "limits": {
    "bytes": 1048576,
    "depth": 32,
    "rows": 10000,
    "series": 50,
    "points": 50000,
    "dimension": 4096
  },
  "sorting": {
    "charts": ["bar", "line", "pie", "funnel"],
    "by": ["category", "value"],
    "orders": ["ascending", "descending"],
    "nulls": ["first", "last"],
    "groupedValue": "unsupported",
    "collation": "utf16-code-unit"
  },
  "units": {
    "charts": ["bar", "line", "scatter"],
    "kinds": ["currency", "percent", "unit"],
    "percentScales": ["percent", "ratio"],
    "conversion": false
  },
  "temporal": {
    "charts": ["line"],
    "kinds": ["date", "instant"],
    "dateFormat": "YYYY-MM-DD",
    "instantFormat": "YYYY-MM-DDTHH:mm:ss[.SSS]Z or ±HH:mm",
    "years": "1000-9999",
    "coordinate": "UTC",
    "displayTimezone": "UTC",
    "namedTimezones": false,
    "numericTimestamps": false
  },
  "aggregation": {
    "charts": ["bar", "line", "pie", "funnel"],
    "operations": ["sum", "mean", "count"],
    "count": "non-null numeric y",
    "allNull": {
      "sum": "null",
      "mean": "null",
      "count": 0
    },
    "identity": "aggregate"
  },
  "presentation": {
    "dataLabels": {
      "show": true,
      "content": "echarts-default",
      "formatter": false
    },
    "legend": {
      "show": true,
      "positions": ["top", "bottom"]
    }
  },
  "combo": {
    "series": ["bar", "line"],
    "axes": ["shared", "right"],
    "x": "ordinal",
    "grouping": false,
    "aggregation": false,
    "units": "shared requires identical or both absent; right requires explicit units for both"
  },
  "funnel": {
    "x": "ordinal",
    "y": "nonnegative",
    "order": "input unless explicitly sorted",
    "conversionRate": "not inferred"
  }
}
