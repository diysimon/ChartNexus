{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mode": {
      "const": "intent"
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "inline"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 100
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maxProperties": 100
              },
              "maxItems": 10000
            }
          },
          "required": ["kind", "fields", "rows"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reference"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": ["kind", "id", "revision"]
        }
      ]
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["bar", "line", "pie", "scatter"]
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "type": {
                  "enum": ["ordinal", "quantitative", "temporal"]
                },
                "temporalKind": {
                  "const": "date"
                }
              },
              "required": ["field", "type"]
            },
            "y": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "type": {
                  "enum": ["ordinal", "quantitative"]
                },
                "unit": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "currency"
                        },
                        "code": {
                          "type": "string",
                          "pattern": "^[A-Z]{3}$"
                        }
                      },
                      "required": ["kind", "code"]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "percent"
                        },
                        "scale": {
                          "enum": ["percent", "ratio"]
                        }
                      },
                      "required": ["kind", "scale"]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "unit"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 32
                        }
                      },
                      "required": ["kind", "label"]
                    }
                  ]
                }
              },
              "required": ["field", "type"]
            },
            "series": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": ["field"]
            }
          },
          "required": ["x", "y"]
        },
        "stack": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "orientation": {
          "enum": ["vertical", "horizontal"]
        },
        "area": {
          "type": "boolean"
        },
        "donut": {
          "type": "boolean"
        },
        "sort": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "by": {
              "enum": ["category", "value"]
            },
            "order": {
              "enum": ["ascending", "descending"]
            },
            "nulls": {
              "enum": ["first", "last"]
            }
          },
          "required": ["by", "order", "nulls"]
        },
        "aggregate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": ["sum", "mean", "count"]
            }
          },
          "required": ["op"]
        }
      },
      "required": ["type", "encoding"]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "enum": ["light", "dark"]
            },
            "version": {
              "const": "1"
            }
          },
          "required": ["id", "version"]
        },
        "dataLabels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": {
              "type": "boolean"
            }
          },
          "required": ["show"]
        },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": {
              "type": "boolean"
            },
            "position": {
              "enum": ["top", "bottom"]
            }
          },
          "required": ["show"]
        }
      }
    }
  },
  "required": ["schemaVersion", "id", "mode", "data", "chart"],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chartnexus.dev/schemas/chart-document/0.2",
  "title": "ChartDocument02",
  "description": "Experimental ChartNexus 0.2 intent profile; no network resolution."
}
