    {
      "id": "create-bar",
      "familyId": "monthly-revenue",
      "split": "development",
      "language": ["en", "zh-CN"],
      "prompt": {
        "en": "Create a bar chart for Jan, Feb, Mar revenue 120, 180, 150.",
        "zh-CN": "将一月至三月的收入 120、180、150 制作柱状图。"
      },
      "schemaVersion": "0.1",
      "provenance": {
        "origin": "project-authored-synthetic",
        "license": "Apache-2.0",
        "productionData": false
      },
      "expected": {
        "result": "compile",
        "assertions": [
          {
            "pointer": "/option/series/0/type",
            "equals": "bar"
          },
          {
            "pointer": "/option/series/0/data",
            "equals": [120, 180, 150]
          },
          {
            "pointer": "/option/xAxis/data",
            "equals": ["Jan", "Feb", "Mar"]
          }
        ]
      },
      "reference": {
        "schemaVersion": "0.1",
        "id": "sales",
        "mode": "intent",
        "data": {
          "kind": "inline",
          "fields": ["month", "revenue"],
          "rows": [
            {
              "month": "Jan",
              "revenue": 120
            },
            {
              "month": "Feb",
              "revenue": 180
            },
            {
              "month": "Mar",
              "revenue": 150
            }
          ]
        },
        "chart": {
          "type": "bar",
          "title": "Monthly sales",
          "encoding": {
            "x": {
              "field": "month",
              "type": "ordinal"
            },
            "y": {
              "field": "revenue",
              "type": "quantitative"
            }
          }
