{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chartnexus.dev/schemas/native-strict-basic/0.1",
  "title": "NativeStrictBasicOption",
  "description": "Experimental bounded subset of ECharts option, not the full ECharts schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "legend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show": {
          "type": "boolean"
        }
      }
    },
    "xAxis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["category", "value"]
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "data": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "required": ["type"]
    },
    "yAxis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["category", "value"]
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "data": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "required": ["type"]
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "id": {
                "type": "string",
                "maxLength": 256
              },
              "type": {
                "enum": ["bar", "line"]
              },
              "stack": {
                "type": "string",
                "maxLength": 256
              },
              "data": {
                "type": "array",
                "maxItems": 10000,
                "items": {
                  "type": ["number", "null"]
                }
              }
            },
            "required": ["type", "data"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "id": {
                "type": "string",
                "maxLength": 256
              },
              "type": {
                "const": "scatter"
              },
              "data": {
                "type": "array",
                "maxItems": 10000,
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": ["number", "null"]
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "required": ["type", "data"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "id": {
                "type": "string",
                "maxLength": 256
              },
              "type": {
                "const": "pie"
              },
              "data": {
                "type": "array",
                "maxItems": 10000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "value": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": ["name", "value"]
                }
              }
            },
            "required": ["type", "data"]
          }
        ]
      }
    },
    "tooltip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show": {
          "type": "boolean"
        }
      }
    },
    "color": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
      }
    },
    "backgroundColor": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    }
  },
  "required": ["series"]
}
